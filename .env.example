# =============================================================================
# Shortly backend: environment variables
# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# "REQUIRED" means the app will not start, or a core feature breaks, without it.
# See README.md, section "Environment variables", for full details.
# =============================================================================

# ---- Server -----------------------------------------------------------------
# HTTP port. All routes are served under the /shortly context path.
PORT=8080

# ---- Database (REQUIRED) ----------------------------------------------------
# MongoDB connection string. Must be a replica set (MongoDB Atlas always is),
# because parcel assignment, driver payouts and bookings use transactions.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shortly?retryWrites=true&w=majority

# ---- JWT authentication (REQUIRED) ------------------------------------------
# Read directly by JWTConfig. Use long random strings (at least 32 bytes each,
# HS256 needs 256-bit keys). Generate with: openssl rand -base64 48
JWT_ACCESS_KEY=change-me-access-key-at-least-32-bytes-long
JWT_REFRESH_KEY=change-me-refresh-key-at-least-32-bytes-long
# Access token lifetime in milliseconds (86400000 = 24 h). Refresh tokens last 7x this.
JWT_EXPIRATION_TIME=86400000

# ---- Frontend / links -------------------------------------------------------
# Frontend origin. Used as the fallback for APP_FRONTEND_URL.
FRONTEND_HOST=http://localhost:3000
# Frontend address put into email and SMS links (/verify-email, /receive?t=...).
# Defaults to FRONTEND_HOST, then http://localhost:3000.
APP_FRONTEND_URL=http://localhost:3000
# Frontend path of the company email-verification page.
EMAIL_VERIFICATION_PATH=/verify-email
# How long a company verification link stays valid, in ms (86400000 = 24 h).
EMAIL_VERIFICATION_EXPIRY_MS=86400000

# ---- SMS: MNotify (REQUIRED for any SMS) ------------------------------------
# API key from https://apps.mnotify.net. Sender ID is fixed to "Synergetics" in application.yml.
MNOTIFY_API=your-mnotify-api-key
# Text receivers a "your parcel has arrived" SMS with the /receive link.
# Costs one SMS per parcel. Default false.
RECEIVER_ARRIVAL_SMS=false

# ---- Email: Mailtrap Sending API (REQUIRED, app will not start without the token) ----
MAILTRAP_API_TOKEN=your-mailtrap-sending-api-token
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
MAILTRAP_FROM_NAME=Shortly
# Sender address. Must be on a domain verified in Mailtrap.
MAIL_FROM=no-reply@shortly.com

# ---- File storage: Cloudflare R2 (REQUIRED, app will not start without these) ----
# R2 API token credentials, not AWS IAM keys.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=mnm-parcel-images
# Public base URL for uploaded images: an r2.dev subdomain or a custom domain bound
# to the bucket. No trailing slash. Without it, image URLs will not resolve.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ---- GPS tracking: Jimi IoT / TrackSolid Pro (REQUIRED for rider tracking) ----
JIMI_APP_KEY=your-jimi-app-key
JIMI_APP_SECRET=your-jimi-app-secret
JIMI_BASE_URL=https://open.tracksolidpro.com/route/rest
# TrackSolid account user id and the MD5 hash (lowercase hex) of its password.
JIMI_USER_ID=your-tracksolid-user-id
JIMI_USER_PASSWORD_MD5=md5-of-tracksolid-password

# ---- Delivery pricing and customer payments (optional) ----------------------
# Google Routes API key for road distances. Empty = straight line x 1.35 ("ESTIMATE").
GOOGLE_MAPS_API_KEY=
# Paystack secret key used to verify customer delivery payments. Empty = bookings fail.
PAYSTACK_SECRET_KEY=

# ---- Optional tuning (Spring properties, settable as env vars) --------------
# Reject pins outside Ghana's bounding box (default true).
# SHORTLY_DELIVERY_LOCATION_RESTRICT_TO_GHANA=true
# Nightly driver-money integrity check, Spring cron in Africa/Accra (default 02:30).
# SHORTLY_INTEGRITY_CRON=0 30 2 * * *
# Delivery / off-task check thresholds (defaults shown; keep in sync with the frontend's trackUtils.ts).
# SHORTLY_TRACKING_VISIT_RADIUS_M=150
# SHORTLY_TRACKING_VISIT_GRACE_MIN=30
# SHORTLY_TRACKING_MARKED_AWAY_M=300
# SHORTLY_TRACKING_STOP_SPEED_KMH=3
# SHORTLY_TRACKING_STOP_MIN_MINUTES=5
# SHORTLY_TRACKING_MAX_GAP_MIN=15
# SHORTLY_TRACKING_DETOUR_CORRIDOR_M=1500
# SHORTLY_TRACKING_DETOUR_MIN_MINUTES=3
# SHORTLY_TRACKING_OFF_TASK_STOP_RADIUS_M=200
# SHORTLY_TRACKING_PLAN_CORRIDOR_GOOGLE_M=500
# SHORTLY_TRACKING_PLAN_CORRIDOR_ESTIMATE_M=1500
